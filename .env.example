# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
RANKER_VERSION=ranker_v2
RETRIEVAL_VERSION=retrieval_v3

# Candidate sizes
LEXICAL_TOPK=80
SEM_ARTICLE_TOPK=40
SEM_CHUNK_TOPK=80
CANDIDATE_CAP=200
# Results per search kept for ranker training (written after the reply)
LOG_CANDIDATES_TOPN=50
# Searches whose ranked results are kept in memory until the next restart (0 = off)
SEARCH_CACHE_SIZE=128

TYPESENSE_API_KEY=change-me
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_COLLECTION=idr_articles_hi_v1
# ICU tokenization for Hindi fields; leave empty to use Typesense's default tokenizer
TYPESENSE_HI_LOCALE=hi

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_ARTICLES=idr_articles_vec_v1
QDRANT_COLLECTION_CHUNKS=idr_chunks_vec_v1

# Query encoder: torch (default) or onnx (see scripts/25_export_onnx_query_encoder.py)
EMBED_BACKEND=torch
EMBED_ONNX_DIR=models/e5-large-onnx
EMBED_ONNX_FILE=onnx/model_qint8_avx2.onnx

# --- English site (scripts/_phase4/english_search_api.py, scripts/en/) ---
# Own collections and log database; Typesense/Qdrant hosts and keys above are shared
EN_TYPESENSE_COLLECTION=idr_en_articles_v1
EN_QDRANT_COLLECTION_ARTICLES=idr_en_articles_vec_v1
EN_QDRANT_COLLECTION_CHUNKS=idr_en_chunks_vec_v1
# The model the English vectors were made with (changing it means re-running 03 and 04 --recreate)
EN_EMBED_MODEL=
# Create once: docker exec search_postgres createdb -U searchuser searchlogs_en
EN_DATABASE_URL=postgresql+psycopg2://searchuser:searchpass@localhost:5432/searchlogs_en

# --- Postgres logging ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=searchlogs
PGUSER=searchuser
PGPASSWORD=searchpass
DATABASE_URL=postgresql+psycopg2://searchuser:searchpass@localhost:5432/searchlogs

# Free Hugging Face token for the IndicTrans2 translation model (scripts/27_translate_articles.py).
# Accept the model terms once at https://huggingface.co/ai4bharat/indictrans2-indic-en-dist-200M
HF_TOKEN=
